[Unit]
Description=Telegram Research Agent - UTD confirmed-source watch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=oc_you
Group=oc_you
WorkingDirectory=/srv/openclaw-you/workspace/telegram-research-agent
EnvironmentFile=/srv/openclaw-you/.env
Environment=PYTHONPATH=/srv/openclaw-you/workspace/telegram-research-agent/src
# Dogfood-approved live delivery gate. Still fails closed unless:
# - --enable-delivery is present below;
# - TELEGRAM_BOT_TOKEN and TELEGRAM_OWNER_CHAT_ID are present in EnvironmentFile;
# - UTD_WATCH_KILL_SWITCH is not 1;
# - a confirmed, unexpired UTD watch profile exists in the PRM DB.
Environment=UTD_WATCH_DELIVERY_ENABLED=1
Environment=UTD_WATCH_KILL_SWITCH=0
Environment=UTD_WATCH_SIDECAR_DB=/srv/openclaw-you/workspace/telegram-research-agent/data/utd_shadow.db
ExecStart=/srv/openclaw-you/venv/bin/python3 -m external_watch.live --enable-shadow --enable-delivery
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/openclaw-you/workspace/telegram-research-agent/data

[Install]
WantedBy=multi-user.target
