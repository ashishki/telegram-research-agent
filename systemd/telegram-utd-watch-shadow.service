[Unit]
Description=UTD source-bounded shadow watch (NO Telegram delivery)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/openclaw-you/workspace/telegram-research-agent
Environment=PYTHONPATH=/srv/openclaw-you/workspace/telegram-research-agent/src
# Disabled template. Do not enable until an explicit deployment approval records
# the concrete PRM DB path, sidecar path and rollback/kill-switch procedure.
ExecStart=/srv/openclaw-you/venv/bin/python3 -m external_watch.live --enable-shadow --show-candidates
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/openclaw-you/workspace/telegram-research-agent/data
