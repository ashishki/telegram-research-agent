{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telegram-research-agent.local/schemas/assistant_brief_document.v1.schema.json",
  "title": "BriefDocument v1",
  "description": "The immutable source DTO for Telegram, HTML, PDF, and Markdown renderers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "version", "owner_ref", "window", "status", "sections", "evidence_refs", "selection_reasons", "previous_version", "coverage_manifest"],
  "properties": {
    "schema_version": {"const": "assistant.brief_document.v1"},
    "brief_id": {"type": "string", "pattern": "^brief_[a-z0-9_-]{3,120}$"},
    "version": {"type": "integer", "minimum": 1},
    "owner_ref": {"type": "string", "pattern": "^owner_[a-z0-9_-]{3,120}$"},
    "window": {"type": "object", "additionalProperties": false, "required": ["timezone", "start_at", "end_at", "generated_at"], "properties": {"timezone": {"type": "string", "minLength": 1, "maxLength": 128}, "start_at": {"type": "string", "format": "date-time"}, "end_at": {"type": "string", "format": "date-time"}, "generated_at": {"type": "string", "format": "date-time"}}},
    "status": {"type": "string", "enum": ["complete", "partial", "empty"]},
    "sections": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["section_id", "title", "items"], "properties": {"section_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,80}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 200}, "items": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "title", "summary", "evidence_refs", "selection_reasons"], "properties": {"item_id": {"type": "string", "pattern": "^brief_item_[a-z0-9_-]{3,120}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 240}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_[a-z0-9_-]{3,120}$"}}, "selection_reasons": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,120}$"}}}}}}}},
    "evidence_refs": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_[a-z0-9_-]{3,120}$"}},
    "selection_reasons": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,120}$"}},
    "previous_version": {"type": ["object", "null"], "additionalProperties": false, "required": ["brief_id", "version"], "properties": {"brief_id": {"type": "string", "pattern": "^brief_[a-z0-9_-]{3,120}$"}, "version": {"type": "integer", "minimum": 1}}},
    "coverage_manifest": {"type": "object", "additionalProperties": false, "required": ["sources", "limitations"], "properties": {"sources": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["source_ref", "state"], "properties": {"source_ref": {"type": "string", "minLength": 1, "maxLength": 512}, "state": {"type": "string", "enum": ["checked", "excluded", "unavailable", "stale", "partial"]}, "reason": {"type": ["string", "null"], "maxLength": 240}}}}, "limitations": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,120}$"}}}}
  }
}
